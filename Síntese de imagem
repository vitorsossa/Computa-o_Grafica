import open3d as o3d


def main():
    # Cria uma esfera tridimensional
    esfera = o3d.geometry.TriangleMesh.create_sphere(
        radius=1.0
    )

    # Calcula as normais para melhorar a representação visual
    esfera.compute_vertex_normals()

    # Define a cor da esfera
    esfera.paint_uniform_color(
        [0.2, 0.6, 1.0]
    )

    # Cria um sistema de coordenadas para referência
    eixos = o3d.geometry.TriangleMesh.create_coordinate_frame(
        size=1.5
    )

    # Exibe os objetos
    o3d.visualization.draw_geometries(
        [esfera, eixos],
        window_name="Computação Gráfica - Esfera 3D"
    )


if __name__ == "__main__":
    main()
