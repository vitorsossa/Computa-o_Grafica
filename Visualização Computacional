import open3d as o3d


def main():
    # Obtém uma nuvem de pontos de exemplo
    dados = o3d.data.PCDPointCloud()

    # Carrega a nuvem de pontos
    nuvem = o3d.io.read_point_cloud(
        dados.path
    )

    # Exibe informações no terminal
    print(nuvem)

    print(
        "Quantidade de pontos:",
        len(nuvem.points)
    )

    # Visualiza a nuvem
    o3d.visualization.draw_geometries(
        [nuvem],
        window_name="Visualização de Nuvem de Pontos"
    )


if __name__ == "__main__":
    main()
